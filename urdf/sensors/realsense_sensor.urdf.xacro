<?xml version="1.0"?>
<robot name="realsense_sensor" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro
      name="realsense_sensor"
      params="
          parent
          name:=^|camera
          use_nominal_extrinsics:=^|true
          add_plug:=false use_mesh:=^|true
          sim_gazebo:=^|false">

    <xacro:property name="M_PI" value="3.1415926535897931" />

    <!-- Include RealSense D435 URDF -->
    <xacro:unless value="${sim_gazebo}">
        <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>

        <!-- Attach RealSense model -->
        <xacro:sensor_d435 parent="${parent}"
            name="${name}"
            use_nominal_extrinsics="${use_nominal_extrinsics}"
            add_plug="${add_plug}"
            use_mesh="${use_mesh}">
          <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        </xacro:sensor_d435>
    </xacro:unless>
    <xacro:if value="${sim_gazebo}">
        <!-- Attach RealSense model with Gazebo plugin -->
        <xacro:include filename="$(find chris_ros_turtlebot2)/urdf/sensors/realsense_d435.urdf.xacro"/>
        <xacro:sensor_d435_gazebo parent="${parent}"
            name="${name}"
            use_nominal_extrinsics="${use_nominal_extrinsics}"
            add_plug="${add_plug}"
            use_mesh="${use_mesh}">
          <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        </xacro:sensor_d435_gazebo>

        <!-- Realsense camera (attached to depth_optical_frame) -->
        <gazebo reference="${name}_depth_frame">
            <sensor name="${name}_rgbd_camera" type="rgbd_camera">
                <pose>0 0 0 0 0 0</pose> <!--${M_PI/2} -${M_PI/2} 0</pose -->
                <update_rate>30</update_rate>
                <visualize>true</visualize>
                <camera>
                    <horizontal_fov>1.57</horizontal_fov>
                    <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                    </image>
                    <clip>
                    <near>0.1</near>
                    <far>10</far>
                    </clip>
                    <optical_frame_id>${name}_depth_optical_frame</optical_frame_id>
                </camera>
                <always_on>true</always_on>
                <visualize>true</visualize>
                <topic>${name}/depth</topic>
            </sensor>
        </gazebo>

    </xacro:if>
  </xacro:macro>

</robot>
